{
  "$schema": "./node_modules/@angular/service-worker/config/schema.json",
  "index": "/index.html",
  "assetGroups": [
    {
      "name": "app",
      "installMode": "prefetch",
      "resources": {
        "files": ["/favicon.svg", "/index.html", "/manifest.webmanifest", "/*.css", "/*.js", "/media/**", "/icons/**"]
      }
    },
    {
      "name": "mediapipe-core",
      "installMode": "prefetch",
      "updateMode": "prefetch",
      "resources": {
        "files": [
          "/mediapipe/pose_landmarker_lite.task",
          "/mediapipe/wasm/vision_wasm_internal.js",
          "/mediapipe/wasm/vision_wasm_internal.wasm"
        ]
      }
    },
    {
      "name": "mediapipe-module",
      "installMode": "lazy",
      "updateMode": "lazy",
      "resources": { "files": ["/mediapipe/wasm/vision_wasm_module_internal.*"] }
    }
  ]
}
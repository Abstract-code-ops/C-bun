{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "newProjectRoot": "projects",
  "projects": {
    "c-bun": {
      "projectType": "application",
      "root": "",
      "sourceRoot": "src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "browser": "src/main.ts",
            "index": "src/index.html",
            "baseHref": "/",
            "tsConfig": "tsconfig.app.json",
            "inlineStyleLanguage": "css",
          "assets": [
            { "glob": "**/*", "input": "public" },
            { "glob": "**/*", "input": "node_modules/@mediapipe/tasks-vision/wasm", "output": "/mediapipe/wasm" }
          ],
          "styles": [
            "node_modules/@fontsource/roboto/latin-300.css",
            "node_modules/@fontsource/roboto/latin-400.css",
            "node_modules/@fontsource/roboto/latin-500.css",
            "node_modules/material-icons/iconfont/material-icons.css",
            "src/material-theme.scss",
            "src/styles.css"
          ],
          "configurations": {
            "production": {
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "700kB",
                  "maximumError": "1MB"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "8kB",
                  "maximumError": "12kB"
                }
              ],
              "outputHashing": "all",
              "serviceWorker": "ngsw-config.json",
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "options": {
            "allowedHosts": true
          },
          "configurations": {
            "production": {
              "buildTarget": "c-bun:build:production"
            },
            "development": {
              "buildTarget": "c-bun:build:development"
            }
          },
          "defaultConfiguration": "development"
        }
      }
    }
  },
  "cli": {
    "analytics": false
  }
}
